# GitHub Packages registry mapping. Public deps still resolve from the default
# npm registry.
#
# THE PUBLISH SCOPE IS @fuzeone (was @izzywdev before the org move).
# GitHub Packages requires an npm scope to match the account that OWNS the
# packages. On 2026-11-06 every Fuze repo moved from the personal account
# **izzywdev** to the **FuzeOne** org, so packages now publish under `@fuzeone`.
# Until then they published under `@izzywdev` because that was the only account
# that owned the repo. This is the long-promised "flip the scope once the org
# transfer happens"; `scripts/publish-packages.mjs` (OWNER_SCOPE) was flipped in
# the same change.
#
#     published cross-repo   ->  @fuzeone/fuzefront-<thing>
#     internal to this repo  ->  @fuzefront/<thing>   (npm workspace, never published)
#
# @fuzefront/* names are npm WORKSPACES declared in the root package.json. npm
# links them from the working tree, so they never touch a registry and need no
# mapping here. That is why the broken mapping went unnoticed for so long — and
# why `Cannot find module '@fuzefront/shared'` (#538) turned out to be a Docker
# packaging bug rather than a registry one.
#
# @izzywdev:registry is KEPT during the migration so anything still resolving an
# old @izzywdev/fuzefront-* version keeps working; it is removed in the cleanup
# phase once all consumers are on @fuzeone. See FuzeSDLC CLAUDE.baseline.md.
@fuzeone:registry=https://npm.pkg.github.com
@izzywdev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Supply-chain: do not resolve package versions published within the last 7
# days, so a compromised-maintainer publish is not picked up before it is
# caught and unpublished. npm >= 11.10. See
# https://github.blog/changelog/2026-02-18-npm-bulk-trusted-publishing-config-and-script-security-now-generally-available/
min-release-age = 7
